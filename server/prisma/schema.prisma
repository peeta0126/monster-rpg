generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  /// 마지막 로그인 시각. 세이브 시각만으로는 "들어왔다가 아무것도 안 하고 나간" 사람이 안 보인다
  lastLoginAt  DateTime?
  saveData     SaveData?
  saveHistory  SaveHistory[]
  logins       LoginEvent[]
}

model SaveData {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      String
  /// 클라이언트의 PERSIST_VERSION. 이게 없어서 서버 세이브는 migrate 를 못 탔다
  version   Int      @default(2)
  /// PUT 마다 1씩. 클라이언트가 마지막으로 본 값과 다르면 409 로 돌려보낸다
  revision  Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// 덮어쓰기 직전 상태를 사용자당 10판까지 남긴다. 기기가 엇갈려 진행이 날아갔을 때의 마지막 수단
model SaveHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      String
  version   Int
  revision  Int
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// 들어온 흔적을 한 줄씩 남긴다. User.lastLoginAt 은 덮어써서 "몇 번 · 언제언제" 를 못 센다.
/// 실패까지 같이 담는 건 남의 계정을 두드린 흔적이 여기 말고는 안 남기 때문이다.
model LoginEvent {
  id        String   @id @default(cuid())
  /// 실패는 없는 아이디로도 들어오므로 계정이 안 붙는다. 계정이 지워지면 null 로 풀린다
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// 계정이 지워져도 "누구였나" 는 남아야 한다. 그래서 userId 와 따로 적는다
  username  String
  /// login | register | fail
  kind      String
  /// 이 PC 한 대로 도는 동안은 대개 127.0.0.1 이다. 밖으로 내보내는 날 쓸모가 생긴다
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}
