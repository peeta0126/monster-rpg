generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  /// 「바로 시작」으로 만들어진 계정. 정식 계정으로 연결되면 false 가 된다
  isAnonymous  Boolean  @default(false)
  saveData     SaveData?
  saveHistory  SaveHistory[]
}

model SaveData {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      String
  /// 클라이언트의 PERSIST_VERSION. 이게 없어서 서버 세이브는 migrate 를 못 탔다
  version   Int      @default(2)
  /// PUT 마다 1씩. 클라이언트가 마지막으로 본 값과 다르면 409 로 돌려보낸다
  revision  Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// 덮어쓰기 직전 상태를 사용자당 10판까지 남긴다. 기기가 엇갈려 진행이 날아갔을 때의 마지막 수단
model SaveHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      String
  version   Int
  revision  Int
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
