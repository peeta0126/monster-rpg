DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
# 「바로 시작」으로 만든 계정용. 아이디를 아무도 안 외우고 있어서 짧게 잡으면 세이브로 돌아갈 길이 끊긴다.
ANON_JWT_EXPIRES_IN="365d"
PORT=4000
# 쉼표로 여러 개. 배포하면 게임 화면(Pages)과 서버(터널)가 다른 도메인에 산다.
CORS_ORIGIN="http://localhost:5173,http://localhost:4173"
# 터널·리버스 프록시 뒤에 둘 때만 1. 안 켜면 요청 제한이 IP 별이 아니라 전역 제한처럼 동작한다.
TRUST_PROXY=0
# /admin 페이지 접속용 비밀키 (플레이어 로그인과 무관). 미설정 시 관리자 라우트는 항상 401.
ADMIN_SECRET="change-me-admin-secret"
