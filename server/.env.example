DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=4000
# 쉼표로 여러 개. 화면과 서버가 같은 PC 에 있으므로 개발(5173)·미리보기(4173)면 된다.
CORS_ORIGIN="http://localhost:5173,http://localhost:4173"
# 앞에 선 프록시의 겹 수. 0 이면 안 믿는다. 모자라면 요청 제한이 IP 별이 아니라 전원 공용이 된다.
# 터널로 바깥에 낼 때는 2 (cloudflared → vite 프록시 → 서버).
TRUST_PROXY=0
# /admin 페이지 접속용 비밀키 (플레이어 로그인과 무관). 미설정 시 관리자 라우트는 항상 401.
ADMIN_SECRET="change-me-admin-secret"
