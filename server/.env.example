DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"
PORT=4000
# 쉼표로 여러 개. 화면과 서버가 같은 PC 에 있으므로 개발(5173)·미리보기(4173)면 된다.
CORS_ORIGIN="http://localhost:5173,http://localhost:4173"
# 리버스 프록시 뒤에 둘 때만 1. 안 켜면 요청 제한이 IP 별이 아니라 전역 제한처럼 동작한다.
TRUST_PROXY=0
# /admin 페이지 접속용 비밀키 (플레이어 로그인과 무관). 미설정 시 관리자 라우트는 항상 401.
ADMIN_SECRET="change-me-admin-secret"
